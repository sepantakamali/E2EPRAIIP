global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: textclf-api
    metrics_path: /metrics
    static_configs:
      - targets: ["metrics-proxy:8080"]
    basic_auth:
      username: prometheus
      password_file: /run/secrets/prometheus_metrics_password

remote_write:
  - url: "${GC_PROM_URL}"
    basic_auth:
      username: "${GC_PROM_USERNAME}"
      password_file: /run/secrets/gc_prom_password
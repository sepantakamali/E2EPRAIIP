# API runtime
LOG_LEVEL=INFO
MODEL_POINTER=latest
MAX_TEXTS=64
MAX_TEXT_LEN=2000
SHOW_DOCS=False

# Monitoring (Grafana Cloud Prometheus)
GC_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GC_PROM_USERNAME=123456
GC_PROM_PASSWORD=glc_your_token_here

# Rate limiting (SlowAPI)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREDICT=60/minute

# UI
API_BASE_URL=http://localhost:8000

# Client demo
CLIENT_DEMO_API_BASE_URL=http://127.0.0.1:8000
CLIENT_DEMO_MODEL=stable
CLIENT_DEMO_TIMEOUT_SECONDS=10
CLIENT_DEMO_TOKEN_FILE=../practice_sprint_secrets/client_demo_token.txt

# Deployed immutable application image
IMAGE_TAG=replace-with-published-image-tag

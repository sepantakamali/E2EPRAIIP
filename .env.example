# API runtime
LOG_LEVEL=INFO
MODEL_POINTER=latest
MAX_TEXTS=64
MAX_TEXT_LEN=2000
SHOW_DOCS=False

# Monitoring (Grafana Cloud Prometheus)
GC_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GC_PROM_USERNAME=123456
GC_PROM_PASSWORD=glc_your_token_here

# Rate limiting (SlowAPI)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREDICT=60/minute

# UI
API_BASE_URL=http://localhost:8000

# Config
Config(
    categories=['rec.sport.hockey', 'talk.politics.mideast'],
    test_size=0.1,
    random_state=42,
    shuffle=True,
    max_features=5000,
    max_iter=200
)

# Pipeline
return Pipeline([
    ("tfidf", TfidfVectorizer(max_features=max_features)),
    ("clf", LogisticRegression(max_iter=max_iter))
])
return Pipeline([
    ('feature_selection', SelectKBest(chi2, k=5000)), # Reduce to top 5000 features
    ('classification', LogisticRegression(solver='saga', multi_class='multinomial'))
])